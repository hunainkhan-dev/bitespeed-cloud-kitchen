# Server environment — copy to server/.env
NODE_ENV=development
PORT=5000

# The deployed frontend origin. REQUIRED in production (locks CORS).
CLIENT_URL=http://localhost:5173

# MongoDB connection string. Use a MongoDB Atlas SRV URI in production.
MONGODB_URI=mongodb://localhost:27017/bitespeed

# Staff-portal secret checked on every admin API call.
# In production this MUST be strong (24+ chars) and unique — generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=bitespeed-staff-2024
